{
  // ================== 糯糯的 ASMR 奇遇 · 配置文件 ==================
  // 第一次运行时会自动复制成 config.json。推荐直接在控制台 http://127.0.0.1:17890/admin 里修改，
  // 也可以用记事本改这个文件（// 后面是说明文字，可以保留）。改完重新启动即可。

  // 你的抖音直播间号：打开 https://live.douyin.com/xxxxxx 能看到你的直播，就填 xxxxxx。
  // 也可以直接把整条网址粘贴进来，或者填你的抖音号。
  "room": "",

  // 互动数据来源：
  //   "douyin"      —— 推荐。程序自动用 Edge/Chrome 打开你的网页直播间读取弹幕、点赞、礼物（静音、不拉视频流）
  //   "barragegrab" —— 备用。配合开源工具 DouyinBarrageGrab（WssBarrageService.exe）使用
  //   "mock"        —— 演示模式，模拟一个几十人的直播间（点赞、弹幕、关注、偶尔的礼物），不开播也能看全部效果
  //   "none"        —— 不连接，只能在控制台点测试按钮
  "source": "douyin",

  // 本地端口（一般不用改）
  "port": 17890,

  // 浏览器路径，留空会自动寻找 Chrome，找不到再用 Windows 自带的 Edge
  "browserPath": "",

  // 启动时自动打开游戏窗口（直播伴侣里用"窗口捕获"选它）
  "launchGame": true,
  "gameWindow": {
    // 画面方向："portrait" 竖屏 9:16（默认。抖音观众几乎都竖着拿手机看，横屏画面在手机上只有小小一条，看不清）
    //           "landscape" 横屏 16:9
    "orientation": "portrait",
    // 窗口里画面的大小。都填 0 = 自动：屏幕放得下的最大尺寸（1080p 显示器上竖屏大约是 562×1000）。
    // 直播伴侣捕获窗口后会拉伸到整个画布；显示器越大（或者把显示器竖过来），画面越清楚。
    "width": 0,
    "height": 0,
    "x": 20,
    "y": 10,
    "fullscreen": false,
    // 如果你的 Windows 显示缩放不是 100%，觉得画面模糊，可以填 1
    "deviceScaleFactor": 0
  },

  "listener": {
    // 一直显示监听窗口（一般不用：抖音要求安全验证时程序会自动把它弹出来，验证完自动收起；也可以在控制台随时点"显示监听窗口"）
    "visible": false,
    // 多少秒收不到任何数据就自动刷新直播间页面
    "reloadIfSilentSec": 150,
    // 不加载直播视频流（省带宽、省电脑性能）。连不上时程序会自动放开重试一次
    "blockVideo": true,
    // 数据帧里解不出弹幕时，改为读取页面聊天区的文字（备用通道）
    "domFallback": true,
    "cdpPort": 19333
  },

  // 使用 BarrageGrab 时它的 WebSocket 地址
  "barrageGrabUrl": "ws://127.0.0.1:8888",
  // 把观众弹幕转给游戏（弹幕可以投票、写烦恼、指挥糯糯；抖音鼓励真实互动，建议保持开启）
  "forwardChat": true,

  // 演示模式：pace 互动的密度（2 = 密一倍）；gifts 要不要模拟礼物
  "mock": { "pace": 1, "gifts": true },

  // 应援榜：每天几点清零（默认早上 5 点），显示前几名（竖屏最多显示 3 名）
  "board": { "resetHour": 5, "size": 5 },

  // 应援值：每一种互动算多少分（应援榜、应援条都按它算）。不花钱的互动也算分，观众才愿意互动
  "points": { "like": 1, "chat": 3, "enter": 1, "share": 20, "follow": 30, "fansclub": 50, "giftPerDiamond": 10 },

  "game": {
    // 渲染精度（电脑卡就调低到 1，显卡好可以 1.5）
    "pixelRatio": 1.25,
    // 动画电影感的后期（亮处柔柔地晕开 + 轻微调色）。电脑很旧、画面卡的话改成 false；掉帧时也会自动关闭
    "post": true,
    // 每隔几小时在关卡之间自动刷新一次页面，彻底清理内存（0 = 不刷新）
    "reloadHours": 6,
    // 每个世界大约玩多久（秒）。时间充裕时糯糯会多踩奶、多享受一会儿；时间紧就少做停顿
    "stageSeconds": 210,
    // 走进每一段时，提示条里显示它的名字（如"✦ 新鲜粉雪 ✦"）
    "showSoundLabels": true,
    // 显示"欢迎 XX"提示
    "showEnter": true,
    // 只想要部分世界就填，例如 ["snow","kitchen","clean"]；留空 = 全部 8 个世界轮换（观众可以用弹幕投票）
    // 可选：snow 雪国棉花糖谷 / forest 秋日落叶林 / slime 史莱姆果冻工坊 / rain 雨天水洼花园 /
    //       beach 彩虹沙滩 / toy 软糖键盘小屋 / kitchen 糯糯小厨房（做饭）/ clean 糯糯大扫除（打扫房间）
    "stages": [],
    // 弹幕指令（"踩" "坐" "踩奶" "跳" "转圈"、说世界名字投票下一关，如"去厨房""想看打扫"）；不想要就改成 false
    "chatCommands": true,
    // 观众弹幕里写的烦恼（8 个字以内）会变成画面里带名字的泡泡，让糯糯踩扁。有敏感词 / 广告过滤；
    // 不想让观众的字出现在画面上就改成 false（泡泡上只用内置的"打工人烦恼清单"）
    "chatOnScreen": true,
    "audio": {
      // 总音量 / 踩踏 ASMR 音量 / 环境声（风、雨、鸟）/ 答谢舞曲
      "master": 1.0,
      "sfx": 0.85,
      "ambience": 0.6,
      "music": 0.5,
      // "stereo" 立体声（推荐：素材本身就是真实立体声录音）；"hrtf" 双耳定位
      "spatial": "stereo"
    },
    "gifts": {
      // 礼物价值分级（抖币）：≥10 中礼物，≥100 大礼物（皇冠+彩带，跳两支舞），≥1000 超级礼物（跳三支舞）
      "tierThresholds": [10, 100, 1000],
      // 小礼物刷屏时，两次答谢舞蹈之间至少间隔几秒（期间的礼物会攒起来一起答谢；"收到礼物"的卡片是立刻弹的）
      "smallCooldown": 8,
      // 消息里没有价格时，按这里的礼物名估算抖币，例如 { "小心心": 1, "嘉年华": 3000 }
      "giftValues": {}
    },
    "hud": {
      "showBoard": true,
      "showTips": true,
      // 画面顶上给主播自己看的"直播间连没连上"小提示（连上以后几秒钟自动消失）
      "showLink": true,
      "boardSize": 5,
      // 自定义轮播提示，留空用默认
      "tips": []
    }
  }
}
